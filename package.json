{
  "name": "rabbit-hole",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy . --project-name rabbit-hole",
    "db:init": "wrangler d1 execute rabbit-hole-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute rabbit-hole-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
